# Linda cloud deployment — copy this file to ".env" in this same folder
# (deploy/). deploy.sh creates it itself on the first run and generates
# an API_TOKEN — you only need to fill in DOMAIN and GEMINI_API_KEY.
# NEVER commit the real .env to git.

# --- Domain (for HTTPS) ---------------------------------------------------
# No domain of your own? Make a free nip.io name from the VM's public IP:
#   DOMAIN=123.45.67.89.nip.io
# (nip.io is a free service that turns an IP into a real DNS name, so
# Caddy gets a free HTTPS certificate. To see your public IP, run this
# on the VM: curl -s ifconfig.me)
# If you have your own domain, use that (its DNS needs an A record
# pointing at the VM's IP).
# Without HTTPS (plain HTTP only, less secure): DOMAIN=:80
DOMAIN=

# --- Brain (cloud) --------------------------------------------------------
# The cloud VM has no GPU, so the brain is Gemini's free tier.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Server lock ----------------------------------------------------------
# Random token — without it, no stranger can use your server.
# deploy.sh generates one itself if it is empty. Enter this token in the
# Flutter app's Settings.
API_TOKEN=

# --- Agent ----------------------------------------------------------------
APPROVAL_MODE=auto
MAX_AGENT_STEPS=15
# The cloud VM has no screen, so the browser runs headless.
# (BROWSER_HEADLESS=true is also set in docker-compose.yml.)
BROWSER_HEADLESS=true

# --- WhatsApp / Instagram auto-reply (v0.6, official Meta APIs) -----------
# Put the tokens here for 24x7 auto-reply. The webhook URLs will be the cloud ones:
# https://<DOMAIN>/webhook/whatsapp and https://<DOMAIN>/webhook/instagram.
# Full setup: MESSAGING_SETUP.md. ON/OFF is controlled from chat ("ab se Instagram
# ke messages dekhna" / "WhatsApp band kar do") — default is OFF.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# INSTAGRAM_TOKEN=
# INSTAGRAM_PAGE_ID=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_APP_SECRET=
