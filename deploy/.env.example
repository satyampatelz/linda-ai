# Linda cloud deployment — copy this file to ".env" in this same folder
# (deploy/). deploy.sh pehli baar me ye khud bana dega aur API_TOKEN
# generate kar dega — tumhe sirf DOMAIN aur GEMINI_API_KEY bharne hain.
# NEVER commit the real .env to git.

# --- Domain (for HTTPS) ---------------------------------------------------
# Apne paas domain nahi hai? VM ke public IP se free nip.io naam banao:
#   DOMAIN=123.45.67.89.nip.io
# (nip.io ek free service hai jo IP ko asli DNS naam bana deti hai, jisse
# Caddy ko free HTTPS certificate mil jata hai. Apna public IP dekhne ke
# liye VM pe ye chalao: curl -s ifconfig.me)
# Apna domain hai toh wahi daalo (uske DNS me A record VM ke IP pe hona chahiye).
# Bina HTTPS ke (plain HTTP only, kam secure): DOMAIN=:80
DOMAIN=

# --- Brain (cloud) --------------------------------------------------------
# Cloud VM me GPU nahi hai, isliye brain Gemini ka free tier hai.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Server lock ----------------------------------------------------------
# Random token — iske bina koi stranger tumhare server ko use nahi kar
# sakta. deploy.sh khaali ho toh khud generate kar dega. Ye token Flutter
# app ki Settings me daalna hai.
API_TOKEN=

# --- Agent ----------------------------------------------------------------
APPROVAL_MODE=auto
MAX_AGENT_STEPS=15
# Cloud VM me screen nahi hai, isliye browser headless chalta hai.
# (docker-compose.yml me bhi BROWSER_HEADLESS=true set hai.)
BROWSER_HEADLESS=true

# --- WhatsApp / Instagram auto-reply (v0.6, official Meta APIs) -----------
# 24x7 auto-reply ke liye tokens yahan daalo. Webhook URL cloud wali hogi:
# https://<DOMAIN>/webhook/whatsapp aur https://<DOMAIN>/webhook/instagram.
# Poora setup: MESSAGING_SETUP.md. ON/OFF chat se hota hai ("ab se Instagram
# ke messages dekhna" / "WhatsApp band kar do") — default OFF hai.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# INSTAGRAM_TOKEN=
# INSTAGRAM_PAGE_ID=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_APP_SECRET=
