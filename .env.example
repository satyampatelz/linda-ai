# Linda v0.2 — copy this file to ".env" and fill in what you use.
# (Easier way: open Settings (⚙️) in the app — everything can be changed
# there, no need to edit this file.)
# NEVER commit your real .env to git (it is in .gitignore).

# --- Brain: which model answers? ------------------------------------------
# "ollama" = local model on your laptop (free, private, no key needed).
# "gemini" = Google Gemini free-tier API (needs a free key, no card).
MODEL_PROVIDER=ollama

# Ollama (local) settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Gemini (free tier) settings — only needed if MODEL_PROVIDER=gemini
# Free key: aistudio.google.com -> Get API key (Google account, no card).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# If Google ever rejects gemini-2.5-flash on the free tier, try one of
# these instead (real models, verified against Google's docs Nov 2026):
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Approval gate ---------------------------------------------------------
# "auto" (default): the agent runs EVERY action immediately, no prompts.
# "ask": git push/clone and Kaggle submit pause for one-click approval in the UI.
APPROVAL_MODE=auto

# --- Browser ---------------------------------------------------------------
# "true" = headless panel mode (default — the browser lives inside the
# chat as a live panel with a "Take control" button).
# "false" = visible Chromium window on screen (watch the agent work).
BROWSER_HEADLESS=true

# --- Agent -----------------------------------------------------------------
MAX_AGENT_STEPS=15

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Cloud server API token (optional) -------------------------------------
# Only for the cloud server (Oracle VM). When set, every API call needs
# "Authorization: Bearer <token>" — otherwise you get a 401. This only
# stops strangers, not the agent: with the right token everything works
# just as on the laptop. Leave it empty on the laptop.
# Make a strong random token, e.g.: openssl rand -hex 24
# API_TOKEN=

# --- Gmail (v0.8, official Gmail API, read-only) -------------------------
# Gmail needs nothing in .env — setup is file-based:
# put client_secret.json in the project folder, then run once:
#   python -m backend.app.gmail.auth
# The token is saved in data/token.json (git-ignored). Steps: GMAIL_SETUP.md.

# --- WhatsApp / Instagram auto-reply (v0.6, official Meta APIs) -----------
# Linda answers WhatsApp and Instagram DMs on its own — without asking
# you. Setup guide: MESSAGING_SETUP.md.
# Easier way: put nothing in .env — say in chat "ab se Instagram ke
# messages dekhna", and paste the token into the secure box that opens.
# This .env way is an alternative for advanced users (never send a token
# as a normal chat message — only the secure box or here).
# ON/OFF is controlled from chat: "ab se Instagram ke messages dekhna" (on)
# or "WhatsApp band kar do" (off). Default is OFF — no reply goes out unasked.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# INSTAGRAM_TOKEN=
# INSTAGRAM_PAGE_ID=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_APP_SECRET=
