# Satyam v0.2 — copy this file to ".env" and fill in what you use.
# (Aasan tareeka: app me Settings (⚙️) kholo — wahan se sab badal jata hai,
# file edit karne ki zaroorat nahi.)
# NEVER commit your real .env to git (it is in .gitignore).

# --- Brain: which model answers? ------------------------------------------
# "ollama" = local model on your laptop (free, private, no key needed).
# "gemini" = Google Gemini free-tier API (needs a free key, no card).
MODEL_PROVIDER=ollama

# Ollama (local) settings
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Gemini (free tier) settings — only needed if MODEL_PROVIDER=gemini
# Free key: aistudio.google.com -> Get API key (Google account, no card).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# If Google ever rejects gemini-2.5-flash on the free tier, try one of these:
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Approval gate ---------------------------------------------------------
# "auto" (default): the agent runs EVERY action immediately, no prompts.
# "ask": git push/clone and Kaggle submit pause for one-click approval in the UI.
APPROVAL_MODE=auto

# --- Browser ---------------------------------------------------------------
# "false" = visible Chromium window (default — watch the agent work).
# "true" = headless, runs in the background.
BROWSER_HEADLESS=false

# --- Agent -----------------------------------------------------------------
MAX_AGENT_STEPS=15

# --- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# --- Cloud server API token (optional) -------------------------------------
# Sirf cloud server (Oracle VM) ke liye. Jab set ho toh har API call ko
# "Authorization: Bearer <token>" chahiye — warna 401 milega. Ye sirf
# strangers ko rokta hai, agent ko nahi: sahi token ke saath sab kuch
# waise hi chalta hai jaise laptop pe. Laptop pe khaali chhodo.
# Ek strong random token banao, jaise: openssl rand -hex 24
# API_TOKEN=

# --- Gmail (v0.8, official Gmail API, read-only) -------------------------
# Gmail ke liye .env me kuch nahi daalna — setup file-based hai:
# client_secret.json project folder me rakho, phir ek baar chalao:
#   python -m backend.app.gmail.auth
# Token data/token.json me save hota hai (git-ignored). Steps: GMAIL_SETUP.md.

# --- WhatsApp / Instagram auto-reply (v0.6, official Meta APIs) -----------
# Satyam WhatsApp aur Instagram DMs ka jawab khud de dega — tujhse poochhega
# nahi. Setup guide: MESSAGING_SETUP.md.
# Aasan tareeka: .env me kuch mat daalo — chat me bolo "ab se Instagram ke
# messages dekhna", aur jo secure box khule usme token paste kar do.
# Ye .env wala tareeka advanced users ke liye alternative hai (token kabhi
# chat ke normal message me mat bhejo — sirf secure box ya yahan).
# ON/OFF chat se hota hai: "ab se Instagram ke messages dekhna" (on) ya
# "WhatsApp band kar do" (off). Default OFF hai — bina bole reply nahi jayega.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# INSTAGRAM_TOKEN=
# INSTAGRAM_PAGE_ID=
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_APP_SECRET=
